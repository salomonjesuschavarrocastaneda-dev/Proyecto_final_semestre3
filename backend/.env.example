# Por defecto se utiliza SQLite para facilitar la ejecución local.
DB_ENGINE=sqlite
# Para MySQL: DB_ENGINE=mysql y completa las variables siguientes.
DB_NAME=magnussig_inventario
DB_USER=root
DB_PASSWORD=CAMBIAR_EN_TU_EQUIPO
DB_HOST=127.0.0.1
DB_PORT=3306
DJANGO_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# SMTP para recuperación de contraseña. Sin SMTP, el endpoint responde con un error explícito.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=usuario
EMAIL_HOST_PASSWORD=CAMBIAR_EN_TU_EQUIPO
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=no-reply@magnussig.com
